{
  "name": "petavu",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build --mode web",
    "build:panel": "vite build --mode panel",
    "build:adminpanel": "vite build --mode adminpanel",
    "build:shop": "vite build --mode shop",
    "build:adminshop": "vite build --mode adminshop",
    "build:all": "npm run typecheck && npm run build:web && npm run build:panel && npm run build:adminpanel && npm run build:shop && npm run build:adminshop",
    "serve": "node scripts/serve.mjs",
    "test:db": "node tests/database.mjs",
    "test:e2e": "playwright test",
    "export:preview": "node scripts/export-preview.mjs",
    "build:public": "vite build --mode public",
    "serve:public": "node scripts/serve-public.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.49.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/node": "22.18.6",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8"
  }
}
