{
  "name": "petavu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PETAVU \u2014 B2B network for the pet and equine industry",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc -b --force",
    "clean": "rm -rf packages/*/dist apps/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo",
    "test": "node --test --test-concurrency=1 tests/",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "seed": "node scripts/seed.mjs",
    "seed:list": "node scripts/seed.mjs --list",
    "status": "node scripts/status.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "start": "node scripts/run.mjs",
    "worker": "node scripts/run.mjs --worker"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.3.11",
    "pg": "8.16.3"
  }
}
