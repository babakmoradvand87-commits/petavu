# Server/runtime public configuration; values here are not credentials.
APP_SCOPE=web
PETAVU_MODE=unconfigured
PETAVU_BASE_DOMAIN=
PETAVU_API_BASE=/api
PORT=8080
# Server-only deployment credentials must be injected by a Secret Manager.
# No real credentials belong in this workspace or in frontend environment variables.
DATABASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional adapter; do not request elevated keys by default.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
