# ---------------------------------------------------------------------------
# PETAVU — نمونهٔ پیکربندی
#
# قاعده (§79): هر مقدار حساس فقط از محیط اجرا می‌آید. هیچ کلید و رمزی در مخزن
# نیست. این فایل نام متغیرها را مستند می‌کند، نه مقدارشان را.
# ---------------------------------------------------------------------------

# محیط اجرا: development | test | staging | production
PETAVU_ENV=development

# دامنهٔ عمومی سایت. کانونیکال و آدرس‌های مطلق از اینجا ساخته می‌شوند، نه از
# هدر درخواست (§80–۸۲).
PETAVU_PUBLIC_ORIGIN=http://localhost:3000

# چهار سطح مستقل، هر کدام دامنهٔ خودش (§5).
PETAVU_PANEL_ORIGIN=http://panel.localhost:3000
PETAVU_ADMIN_ORIGIN=http://adminpanel.localhost:3000
PETAVU_SHOP_ORIGIN=http://shop.localhost:3000
PETAVU_ADMIN_SHOP_ORIGIN=http://adminshop.localhost:3000

# پایگاه‌داده. خالی باشد، موتور تعبیه‌شدهٔ توسعه استفاده می‌شود (§48).
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# رازها. در محیط‌های غیرتوسعه اجباری‌اند (§9، §11).
SESSION_SECRET=
AUTH_PEPPER=
SESSION_COOKIE_NAME=pv_session

# فضای ذخیره‌سازی رسانه (§75)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/media

# سرویس‌های اختیاری. خالی یعنی «تنظیم نشده» — و این وضعیت صادقانه گزارش می‌شود،
# نه با Mock پوشانده (§102).
EMAIL_DRIVER=none
SEARCH_DRIVER=postgres
BACKUP_DIR=./.data/backups

# درگاه‌ها
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
API_PORT=4000

LOG_LEVEL=info
TRUST_PROXY=false
